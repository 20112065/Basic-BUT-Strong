<section class="ui left aligned middle aligned segment">
  
<section class="dashboard-header">

  <h2 class="title">Basic BUT Strong Dashboard</h2>

       <form action="/searchCategory" method="GET" class="ui form">
        
      <div class="ui inline fields">
        <div class="field">
          <input type="text" name="searchTerm" placeholder="Search by title..." value="{{search}}">
        </div>

        <div class="field">
          <label>Sort by:</label>
          <select class="ui dropdown" name="sort" onchange="this.form.submit()">
            <option value="Name" {{#if titleSelected}}selected{{/if}}>Name</option>
            <option value="rating" {{#if ratingSelected}}selected{{/if}}>Rating</option>
          </select>
        </div>

        <div class="field">
          <label>Order:</label>
          <select class="ui dropdown" name="order" onchange="this.form.submit()">
            <option value="asc" {{#if ascSelected}}selected{{/if}}>↑</option>
            <option value="desc" {{#if descSelected}}selected{{/if}}>↓</option>
          </select>
        </div>
      </div>

    </form>


</section>

{{#unless search}}
  {{#unless workouts}}
    <h3 class="ui message">
       Start adding your workouts!
    </h3>
  {{/unless}}
{{/unless}}

  
  {{#unless workouts}}
    <h3 class="ui message">
      Start adding your workouts!
    </h3>
  {{/unless}}

  {{#each workouts}}
    <section class="ui left aligned middle aligned segment">

      <h3 class="ui header">
        {{title}}
      </h3>
      
      {{#if exercises}}
        <p>
          Total exercises: {{exercises.length}}
        </p>
      {{else}}
        <p>
          Empty workout!
        </p>
      {{/if}}
      <a href="/workout/{{id}}">
        <i class="ui open folder outline black icon"></i>
      </a>
      <a href="/dashboard/deleteworkout/{{id}}">
   <i class="ui trash black icon"></i>
</a>

    </section>
  {{/each}}

</section>
