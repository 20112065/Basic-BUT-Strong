<form class="ui stacked segment form" action="/workout/{{id}}/addexercise" method="POST">
  <div class="two fields">
    <div class="field">
      <label>Title</label>
      <input type="text" name="" autofocus required title = "Please include a valid Title"
	  placeholder="Title">
    </div>
    <div class="field">
      <label>Exercise</label>
      <input type="text" name="exercise" required title = "Please include a valid Exercise"
	  placeholder="Exercise"  >
    </div>
  </div>
  <button class="ui blue submit button">Add Exercise</button>
</form>
