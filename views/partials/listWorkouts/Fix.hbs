<section class="ui left aligned middle aligned segment">
  
  <h2>Workout App Dashboard</h2>
  
  {{#unless workouts}}
    <h3 class="ui message">
      Start adding your workouts!
    </h3>
  {{/unless}}

  {{#each workouts}}
    <section class="ui left aligned middle aligned segment">

      <h3 class="ui header">
        {{title}}
      </h3>
      
      {{#if exercises}}
        <p>
          Total exercises: {{exercises.length}}
        </p>
      {{else}}
        <p>
          Empty workout!
        </p>
      {{/if}}
	  <a href="/workout/{{id}}">
	     <i class = "ui open folder outline black icon"></i>
	  </a>
    </section>
  {{/each}}

</section>
