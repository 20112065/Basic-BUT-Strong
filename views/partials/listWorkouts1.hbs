{{#if exercises}}

  <table class="ui unstackable striped table">
    <thead>
      <tr>
        <th>Exercise</th>
        <th>Weight</th>
        <th>Sets</th>
        <th>Reps</th>
        <th>Equipment</th>
      </tr>
    </thead>
    <tbody>
      {{#each exercises}}
        <tr>
          <td>
            {{exercise}}
          </td>
          <td>
            {{weight}}
          </td>
          <td>
            {{sets}}
          </td>
          <td>
            {{reps}}
          </td>
          <td>
            {{equipment}}
          </td>
          <td class="center aligned">
    <a href="/workout/{{../id}}/deleteexercise/{{id}}" 
	        title="Delete exercise">
            <i class="ui black trash icon"></i>
    </a>
</td>

        </tr>
      {{/each}}
    </tbody>
  </table>

  {{else}}
    <h3 class="ui message">
      Empty workout!
    </h3>

{{/if}}
