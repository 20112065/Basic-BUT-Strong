{{> menu id="about"}}

<section class="ui left aligned middle aligned segment">

  <h2>About Basic BUT Strong</h2>
  <p>
    The purpose of this web application is to store workouts created by you, the user.
  </p>


{{#each employees}}
  <div class="ui centered card">
    <div class="image">
      <img src="{{image}}">
    </div>
    <div class="content">
      <a class="header">{{fullname}}</a>
      <div class="meta">
        <span class="date">Joined in {{joined}}</span>
      </div>
      <div class="description">
        {{name}} is an {{job}} living in {{city}}.
      </div>
    </div>
    <div class="extra content">
      <a>
        <i class="user icon"></i>
        {{mates}} contacts
      </a>
    </div>
  </div>
{{/each}}

</section>